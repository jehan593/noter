<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nord0"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- The title chip is the reliable tap target that opens the app. -->
    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_title_chip"
        android:drawableEnd="@drawable/ic_widget_open"
        android:drawablePadding="6dp"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:text="@string/widget_title_note"
        android:textColor="@color/nord8"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Always keep at least one row (a dimmed placeholder when blank) so the list keeps touch handling. -->
    <ListView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:divider="@null"
        android:scrollbars="none" />

</LinearLayout>
